#
# `comfyui-strix`: state/models dirs, environment defaults, generated
# extra_model_paths.yaml, model preflight, then ComfyUI in the foreground.
{
  lib,
  writeShellApplication,
  coreutils,
  comfyui,
  comfyui-models,
  customNodesTree,
  manifest,
}:
writeShellApplication {
  name = "comfyui-strix";
  runtimeInputs = [
    coreutils
    comfyui-models
  ];
  text = ''
    usage() {
      cat <<'EOF'
    Usage: comfyui-strix [options] [-- extra ComfyUI args]

      --state-dir DIR     user, input, output, temp, custom_nodes, caches
                          (env COMFYUI_STATE_DIR; default
                          ''${XDG_STATE_HOME:-~/.local/state}/comfyui-strix)
      --models-dir DIR    model tree (env COMFYUI_MODELS_DIR; default /data/models/comfyui)
      --listen ADDR       (env COMFYUI_LISTEN; default 127.0.0.1)
      --port PORT         (env COMFYUI_PORT; default 8188)
      --skip-model-check  do not run `comfyui-models check` first
                          (env COMFYUI_SKIP_MODEL_CHECK=1)

    Default ComfyUI flags (replace with env COMFYUI_ARGS):
      --disable-mmap --bf16-vae --highvram --disable-partner-nodes
    EOF
    }

    state="''${COMFYUI_STATE_DIR:-''${XDG_STATE_HOME:-$HOME/.local/state}/comfyui-strix}"
    models="''${COMFYUI_MODELS_DIR:-/data/models/comfyui}"
    listen="''${COMFYUI_LISTEN:-127.0.0.1}"
    port="''${COMFYUI_PORT:-8188}"
    skip_check="''${COMFYUI_SKIP_MODEL_CHECK:-0}"
    extra=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --state-dir) state="$2"; shift 2 ;;
        --models-dir) models="$2"; shift 2 ;;
        --listen) listen="$2"; shift 2 ;;
        --port) port="$2"; shift 2 ;;
        --skip-model-check) skip_check=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; extra+=("$@"); break ;;
        *) extra+=("$1"); shift ;;
      esac
    done
    read -r -a args <<< "''${COMFYUI_ARGS---disable-mmap --bf16-vae --highvram --disable-partner-nodes}"

    for d in user input output temp custom_nodes cache/miopen cache/triton cache/torchinductor cache/huggingface; do
      mkdir -p "$state/$d"
    done
    mkdir -p "$models"

    # Caches that would otherwise land in $HOME (read-only under the service
    # sandbox) go to the state dir. Anything already set wins.
    export XDG_CACHE_HOME="''${XDG_CACHE_HOME:-$state/cache}"
    export MIOPEN_USER_DB_PATH="''${MIOPEN_USER_DB_PATH:-$state/cache/miopen}"
    export MIOPEN_CUSTOM_CACHE_DIR="''${MIOPEN_CUSTOM_CACHE_DIR:-$state/cache/miopen}"
    export MIOPEN_SEARCH_CUTOFF="''${MIOPEN_SEARCH_CUTOFF:-1}"
    export TRITON_CACHE_DIR="''${TRITON_CACHE_DIR:-$state/cache/triton}"
    export TORCHINDUCTOR_CACHE_DIR="''${TORCHINDUCTOR_CACHE_DIR:-$state/cache/torchinductor}"
    export HF_HOME="''${HF_HOME:-$state/cache/huggingface}"

    # Curated (store) custom nodes in addition to $state/custom_nodes.
    cat > "$state/extra_model_paths.yaml" <<EOF
    # generated by comfyui-strix at every start; edits are overwritten
    comfyui_strix_store_nodes:
      custom_nodes: ${customNodesTree}
    EOF

    if [ "$skip_check" != 1 ]; then
      COMFYUI_MODELS_MANIFEST="''${COMFYUI_MODELS_MANIFEST:-${manifest}}" \
        comfyui-models check --models-dir "$models" || exit 1
    fi

    exec ${lib.getExe comfyui} \
      --base-directory "$state" \
      --models-directory "$models" \
      --extra-model-paths-config "$state/extra_model_paths.yaml" \
      --listen "$listen" --port "$port" \
      --disable-auto-launch \
      "''${args[@]}" "''${extra[@]}"
  '';
  passthru = { inherit comfyui manifest customNodesTree; };
  meta = {
    description = "Run ComfyUI (ROCm, gfx1151) with nix-comfyui-strix defaults";
    license = lib.licenses.gpl3Plus;
    mainProgram = "comfyui-strix";
  };
}
